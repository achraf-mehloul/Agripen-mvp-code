#define SOIL_ANALOG_PIN 34
#define SOIL_DIGITAL_PIN 27

const int SAMPLES = 50;

void setup() {
  Serial.begin(115200);

  analogReadResolution(12);
  analogSetPinAttenuation(SOIL_ANALOG_PIN, ADC_11db);

  pinMode(SOIL_DIGITAL_PIN, INPUT);

  Serial.println();
  Serial.println("========================================");
  Serial.println("          AGRIPEN SOIL SENSOR");
  Serial.println("========================================");
  Serial.println("System Status     : ONLINE");
  Serial.println("Sensor            : HW-080");
  Serial.println("Analog Pin        : GPIO 34");
  Serial.println("Digital Pin       : GPIO 27");
  Serial.println("ADC Resolution    : 12-bit");
  Serial.println("========================================");
}

void loop() {
  long total = 0;
  int minimum = 4095;
  int maximum = 0;

  for (int i = 0; i < SAMPLES; i++) {
    int value = analogRead(SOIL_ANALOG_PIN);

    total += value;

    if (value < minimum)
      minimum = value;

    if (value > maximum)
      maximum = value;

    delay(10);
  }

  float average = total / (float)SAMPLES;
  float voltage = (average / 4095.0f) * 3.3f;

  int digitalState = digitalRead(SOIL_DIGITAL_PIN);

  Serial.println();
  Serial.println("========================================");
  Serial.println("           AGRIPEN SOIL DATA");
  Serial.println("========================================");

  Serial.print("Sensor Status     : ONLINE");
  Serial.println();

  Serial.print("Raw ADC Average   : ");
  Serial.println(average, 0);

  Serial.print("Raw ADC Minimum   : ");
  Serial.println(minimum);

  Serial.print("Raw ADC Maximum   : ");
  Serial.println(maximum);

  Serial.print("Analog Voltage    : ");
  Serial.print(voltage, 3);
  Serial.println(" V");

  Serial.print("Digital Output    : ");

  if (digitalState == LOW)
    Serial.println("WET");
  else
    Serial.println("DRY");

  Serial.println("========================================");

  delay(1500);
}
